# Variables d'environnement (a definir dans Render > Environment, ou dans votre terminal en local).
# Ne jamais committer de vraies valeurs.

# --- IA ---------------------------------------------------------------
# Option 1 (defaut) : Google Gemini, offre gratuite -> https://aistudio.google.com/apikey
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.8-flash

# Option 2 : modele open source via une API compatible OpenAI
# Groq (gratuit, Llama 3.3 70B)   -> https://console.groq.com/keys
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# OpenRouter (modeles ":free")    -> AI_BASE_URL=https://openrouter.ai/api/v1  AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Ollama auto-heberge (sans cle)  -> AI_BASE_URL=http://votre-serveur:11434/v1  AI_MODEL=llama3.1

# --- Base de donnees ---------------------------------------------------
# PostgreSQL persistant (recommande en production, ex. Neon gratuit) :
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require
# Sans DATABASE_URL : fichier SQLite local data/pact.sqlite (efface a chaque redemarrage sur Render gratuit)
DATABASE_URL=

TZ=Africa/Abidjan
